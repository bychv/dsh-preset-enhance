{
  "name": "dsh-preset-enhance",
  "version": "0.3.3-rc.1",
  "type": "module",
  "description": "SillyTavern prompt presets, macros and editor for DeepSeek Harness",
  "author": "bychv <89071107+bychv@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bychv/dsh-preset-enhance.git"
  },
  "homepage": "https://github.com/bychv/dsh-preset-enhance",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./mode": "./mode.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "mode.mjs",
    "client.js",
    "agent-mode",
    "lib",
    "vendor",
    "web",
    "cordis.patch.yml",
    "README.md",
    "PRESET_FORMAT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.5-rc.2 <0.1.6 || =0.1.6-alpha.2 || =0.1.7-alpha.1 || =0.1.7-alpha.2 || =0.1.7-rc.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "test:mcp:candidate": "node scripts/sandbox-verify.mjs mcp --slot candidate",
    "test:stability": "node scripts/preset-stability.mjs",
    "bench:stability": "node scripts/preset-stability-bench.mjs",
    "check": "npm run typecheck && node --check index.mjs && node --check lib/output-extractor.mjs && node --check web/editor.js && node --check web/tool-labels.js && node --check client.js && node --check scripts/preset-stability.mjs && node --check scripts/preset-stability-core.mjs && node --check scripts/preset-stability-strategy.mjs && node --check scripts/preset-stability-stream.mjs && node --check scripts/preset-stability-bench.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
