{
  "name": "dsh-preset-display-regex",
  "version": "0.3.6-alpha.3",
  "type": "module",
  "description": "可选的助手正文正则显示替换",
  "author": "bychv <89071107+bychv@users.noreply.github.com>",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./display-api": {
      "types": "./display-api.d.mts",
      "default": "./display-api.mjs"
    },
    "./locale/*": "./locale/*"
  },
  "files": [
    "index.mjs",
    "client.js",
    "runtime.mjs",
    "executor.mjs",
    "worker.js",
    "regex",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "display-api.mjs",
    "display-api.d.mts",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": [
        "react",
        "react-dom/client",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-0 <0.2.2"
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bychv/dsh-preset-enhance.git",
    "directory": "packages/display-regex"
  }
}
